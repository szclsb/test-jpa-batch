<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="1000" author="szclsb" context="default">
        <tagDatabase tag="1.0"/>
    </changeSet>

    <changeSet id="1001" author="szclsb" context="default">
        <createSequence sequenceName="seq_contact" startValue="1000" incrementBy="1"/>
        <createTable tableName="source_contacts">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_source_contacts"/>
            </column>
            <column name="version" type="bigint"/>
            <column name="valid" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="varchar(63)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(255)"/>
            <column name="last_name" type="varchar(255)"/>
            <column name="date_of_birth" type="date"/>
            <column name="sex" type="varchar(63)"/>
            <column name="email" type="varchar(255)"/>
            <column name="phone" type="varchar(255)"/>
            <column name="language" type="varchar(63)"/>
            <column name="language_alternative" type="varchar(63)"/>
            <column name="street" type="varchar(255)"/>
            <column name="postal_code" type="int"/>
            <column name="city" type="varchar(255)"/>
            <column name="country" type="varchar(255)"/>
        </createTable>
        <createTable tableName="target_contacts">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="pk_target_contacts"/>
            </column>
            <column name="version" type="bigint"/>
            <column name="valid" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="varchar(63)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(255)"/>
            <column name="last_name" type="varchar(255)"/>
            <column name="date_of_birth" type="date"/>
            <column name="sex" type="varchar(63)"/>
            <column name="email" type="varchar(255)"/>
            <column name="phone" type="varchar(255)"/>
            <column name="language" type="varchar(63)"/>
            <column name="language_alternative" type="varchar(63)"/>
            <column name="street" type="varchar(255)"/>
            <column name="postal_code" type="int"/>
            <column name="city" type="varchar(255)"/>
            <column name="country" type="varchar(255)"/>
        </createTable>

        <rollback>
            <dropTable tableName="target_contacts"/>
            <dropTable tableName="source_contacts"/>
            <dropSequence sequenceName="seq_contact"/>
        </rollback>
    </changeSet>
</databaseChangeLog>